# Server Environment Variables
PORT=5000
NODE_ENV=development

# MongoDB Connection (Local or Atlas URI)
# If local MongoDB is not running, the server automatically boots an in-memory database for seamless development!
MONGODB_URI=mongodb://127.0.0.1:27017/student_mgmt_db

# Security & Authentication
JWT_SECRET=super-secret-jwt-key-student-mgmt-2026
JWT_EXPIRES_IN=7d

# Default Admin Credentials
ADMIN_DEFAULT_ID=admin-profpankaj25
ADMIN_DEFAULT_PASSWORD=pass1225
ADMIN_NAME=Prof. Pankaj Sharma
ADMIN_EMAIL=prof.pankaj@university.edu

# Google OAuth Credentials (for Student Login)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Client Origin
